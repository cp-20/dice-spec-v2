{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "jsdoc",
    "jsx-a11y",
    "import",
    "nextjs",
    "node",
    "oxc",
    "promise",
    "react",
    "react-perf",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "rules": {
    "import/namespace": "off",
    "import/no-cycle": "error",
    "vitest/expect-expect": [
      "warn",
      {
        "assertFunctionNames": ["expect", "expect*", "assertSucceeds", "assertFails"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**", "@/features/**"],
                "message": "sharedからappまたはfeaturesへ依存できません"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app/**"],
                "message": "featuresからappへ依存できません"
              }
            ]
          }
        ]
      }
    }
  ]
}
