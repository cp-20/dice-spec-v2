{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "/public/*": ["./public/*"]
    },
    "types": ["web", "vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".cloudflare/types/**/*.ts"],
  "exclude": ["node_modules"]
}
