rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isUserPlan(plan) {
      return plan == 'free' || plan == 'pro';
    }

    function isVisibilityLevel(level) {
      return level == 'private' || level == 'unlisted' || level == 'public';
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasOnly(keys);
    }

    function requiredUserKeys() {
      return [
        'id',
        'name',
        'avatarUrl',
        'plan',
        'createdAt',
        'updatedAt',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'analysisCount',
        'analysisCountSyncAnalysisId',
        'ccfoliaCharacterCount',
        'ccfoliaCharacterCountSyncCharacterId',
      ];
    }

    function analysisCountOf(userData) {
      return 'analysisCount' in userData ? userData.analysisCount : 0;
    }

    function isValidAnalysisCount(value) {
      return value is int && value >= 0;
    }

    function ccfoliaCharacterCountOf(userData) {
      return 'ccfoliaCharacterCount' in userData ? userData.ccfoliaCharacterCount : 0;
    }

    function isValidCcfoliaCharacterCount(value) {
      return value is int && value >= 0;
    }

    function isFiniteNumber(value) {
      return value is number && !math.isNaN(value) && !math.isNaN(value - value);
    }

    function isValidUserDocument(data) {
      return hasOnlyKeys(data, requiredUserKeys())
        && data.id is string
        && data.name is string
        && (!('avatarUrl' in data) || data.avatarUrl == null || data.avatarUrl is string)
        && isUserPlan(data.plan)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.stripeCustomerId is string
        && (!('stripeSubscriptionId' in data) || data.stripeSubscriptionId is string)
        && (!('analysisCount' in data) || isValidAnalysisCount(data.analysisCount))
        && (!('analysisCountSyncAnalysisId' in data)
          || data.analysisCountSyncAnalysisId == null
          || data.analysisCountSyncAnalysisId is string)
        && (!('ccfoliaCharacterCount' in data) || isValidCcfoliaCharacterCount(data.ccfoliaCharacterCount))
        && (!('ccfoliaCharacterCountSyncCharacterId' in data)
          || data.ccfoliaCharacterCountSyncCharacterId == null
          || data.ccfoliaCharacterCountSyncCharacterId is string);
    }

    function requiredCcfoliaCharacterKeys() {
      return [
        'id',
        'schemaVersion',
        'revision',
        'name',
        'memo',
        'initiative',
        'externalUrl',
        'status',
        'params',
        'color',
        'commands',
        'clipboardExtensions',
        'createdAt',
        'updatedAt',
      ];
    }

    function isValidCcfoliaClipboardExtensions(data) {
      return data is map
        && hasOnlyKeys(data, ['angle', 'width', 'height', 'secret', 'invisible', 'hideStatus', 'owner'])
        && (!('angle' in data) || isFiniteNumber(data.angle))
        && (!('width' in data) || isFiniteNumber(data.width))
        && (!('height' in data) || isFiniteNumber(data.height))
        && (!('secret' in data) || data.secret is bool)
        && (!('invisible' in data) || data.invisible is bool)
        && (!('hideStatus' in data) || data.hideStatus is bool)
        && (!('owner' in data) || data.owner == null || (data.owner is string && data.owner.size() <= 2048));
    }

    function isValidCcfoliaCharacterDocument(data, characterId) {
      return hasOnlyKeys(data, requiredCcfoliaCharacterKeys())
        && data.id is string
        && data.id == characterId
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.memo is string
        && data.memo.size() <= 50000
        && (data.initiative == null || isFiniteNumber(data.initiative))
        && data.externalUrl is string
        && data.externalUrl.size() <= 2048
        // Security Rules では可変長リストの全要素を汎用的に検証できないため、所有者だけが書けるここでは
        // リスト型と件数を制限し、要素のスキーマは保存前と読み取り時にクライアントで検証する。
        && data.status is list
        && data.status.size() <= 100
        && data.params is list
        && data.params.size() <= 200
        && data.color is string
        && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.commands is string
        && data.commands.size() <= 100000
        && (!('clipboardExtensions' in data) || isValidCcfoliaClipboardExtensions(data.clipboardExtensions))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicOwner(owner) {
      return hasOnlyKeys(owner, ['id', 'name', 'avatarUrl', 'plan', 'createdAt', 'updatedAt'])
        && owner.id is string
        && owner.name is string
        && (!('avatarUrl' in owner) || owner.avatarUrl == null || owner.avatarUrl is string)
        && isUserPlan(owner.plan)
        && owner.createdAt is timestamp
        && owner.updatedAt is timestamp;
    }

    function isValidPublicOwnerByUserDoc(owner, uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let userDoc = getAfter(userPath);
      return userDoc.data != null
        && owner.id == uid
        && owner.name == userDoc.data.name
        && owner.get('avatarUrl', null) == userDoc.data.get('avatarUrl', null)
        && owner.plan == userDoc.data.plan
        && owner.createdAt == userDoc.data.createdAt
        && owner.updatedAt is timestamp;
    }

    function requiredAnalysisKeys() {
      return [
        'id',
        'title',
        'ownerUid',
        'systemId',
        'visibilityLevel',
        'showRecordDetails',
        'characterResults',
        'sessionDate',
        'createdAt',
        'updatedAt',
        'primaryDeviationScore',
        'owner',
      ];
    }

    function isValidAnalysisDocument(data, analysisId) {
      return hasOnlyKeys(data, requiredAnalysisKeys())
        && data.id is string
        && data.id == analysisId
        && data.title is string
        && data.ownerUid is string
        && data.systemId in ['emoklore', 'CoC7th', 'CoC6th', 'shinobigami', 'nechronica', 'SwordWorld2.5']
        && isVisibilityLevel(data.visibilityLevel)
        && data.showRecordDetails is bool
        && data.characterResults is list
        && data.characterResults.size() > 0
        && data.characterResults[0] is map
        && data.characterResults[0].id == 'all'
        && data.characterResults[0].summary is map
        && data.characterResults[0].summary.deviationScore is number
        && data.sessionDate is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.primaryDeviationScore is number
        && data.primaryDeviationScore == data.characterResults[0].summary.deviationScore
        && data.owner is map
        && isValidPublicOwner(data.owner)
        && isValidPublicOwnerByUserDoc(data.owner, data.ownerUid);
    }

    function isAnalysisOwnerByResource() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isAnalysisOwnerByRequest() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function canReadAnalysisDoc() {
      return isAnalysisOwnerByResource() || resource.data.visibilityLevel == 'public' || resource.data.visibilityLevel == 'unlisted';
    }

    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isUserProfileUpdateOnly() {
      return affectedKeys().hasOnly(['name', 'avatarUrl', 'updatedAt'])
        && request.resource.data.name is string
        && (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || request.resource.data.avatarUrl is string)
        && request.resource.data.updatedAt is timestamp;
    }

    function isUserAnalysisCountSyncUpdate() {
      let nextCount = analysisCountOf(request.resource.data);
      let prevCount = analysisCountOf(resource.data);
      let syncAnalysisId =
        ('analysisCountSyncAnalysisId' in request.resource.data
          && request.resource.data.analysisCountSyncAnalysisId is string)
          ? request.resource.data.analysisCountSyncAnalysisId
          : '';
      let analysisPath = /databases/$(database)/documents/analyses/$(syncAnalysisId);
      let analysisCreated = !exists(analysisPath) && existsAfter(analysisPath);
      let analysisDeleted = exists(analysisPath) && !existsAfter(analysisPath);

      return affectedKeys().hasOnly(['analysisCount', 'analysisCountSyncAnalysisId', 'updatedAt'])
        && isValidAnalysisCount(nextCount)
        && syncAnalysisId is string
        && syncAnalysisId.size() > 0
        && request.resource.data.updatedAt is timestamp
        && (
          (nextCount == prevCount + 1 && analysisCreated)
          || (nextCount == prevCount - 1 && analysisDeleted)
        );
    }

    function isUserCcfoliaCharacterCountSyncUpdate() {
      let nextCount = ccfoliaCharacterCountOf(request.resource.data);
      let prevCount = ccfoliaCharacterCountOf(resource.data);
      let syncCharacterId =
        ('ccfoliaCharacterCountSyncCharacterId' in request.resource.data
          && request.resource.data.ccfoliaCharacterCountSyncCharacterId is string)
          ? request.resource.data.ccfoliaCharacterCountSyncCharacterId
          : '';
      let characterPath =
        /databases/$(database)/documents/users/$(request.auth.uid)/ccfoliaCharacters/$(syncCharacterId);
      let characterCreated = !exists(characterPath) && existsAfter(characterPath);
      let characterDeleted = exists(characterPath) && !existsAfter(characterPath);

      return affectedKeys().hasOnly([
          'ccfoliaCharacterCount',
          'ccfoliaCharacterCountSyncCharacterId',
          'updatedAt',
        ])
        && isValidCcfoliaCharacterCount(nextCount)
        && syncCharacterId.size() > 0
        && request.resource.data.updatedAt == request.time
        && (
          (nextCount == prevCount + 1 && characterCreated)
          || (nextCount == prevCount - 1 && characterDeleted)
        );
    }

    function isAnalysisMetaUpdateOnly() {
      return affectedKeys().hasOnly(['title', 'visibilityLevel', 'showRecordDetails', 'sessionDate', 'updatedAt'])
        && request.resource.data.title is string
        && isVisibilityLevel(request.resource.data.visibilityLevel)
        && request.resource.data.showRecordDetails is bool
        && request.resource.data.sessionDate is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isAnalysisOwnerSyncUpdateOnly() {
      return affectedKeys().hasOnly(['owner', 'updatedAt'])
        && request.resource.data.owner is map
        && isValidPublicOwner(request.resource.data.owner)
        && request.resource.data.updatedAt is timestamp
        && isValidPublicOwnerByUserDoc(request.resource.data.owner, request.resource.data.ownerUid);
    }

    function linkedUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function linkedUserAfter(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid));
    }

    function isAnalysisCountIncrementSynced(uid, analysisId) {
      let userBefore = linkedUser(uid);
      let userAfter = linkedUserAfter(uid);

      return userBefore.data != null
        && userAfter.data != null
        && isValidAnalysisCount(analysisCountOf(userBefore.data))
        && isValidAnalysisCount(analysisCountOf(userAfter.data))
        && analysisCountOf(userAfter.data) == analysisCountOf(userBefore.data) + 1
        && userAfter.data.analysisCountSyncAnalysisId is string
        && userAfter.data.analysisCountSyncAnalysisId == analysisId;
    }

    function isAnalysisCountDecrementSynced(uid, analysisId) {
      let userBefore = linkedUser(uid);
      let userAfter = linkedUserAfter(uid);

      return userBefore.data != null
        && userAfter.data != null
        && isValidAnalysisCount(analysisCountOf(userBefore.data))
        && isValidAnalysisCount(analysisCountOf(userAfter.data))
        && analysisCountOf(userAfter.data) == analysisCountOf(userBefore.data) - 1
        && userAfter.data.analysisCountSyncAnalysisId is string
        && userAfter.data.analysisCountSyncAnalysisId == analysisId;
    }

    function isCcfoliaCharacterCountIncrementSynced(uid, characterId) {
      let userBefore = linkedUser(uid);
      let userAfter = linkedUserAfter(uid);

      return userBefore.data != null
        && userAfter.data != null
        && isValidCcfoliaCharacterCount(ccfoliaCharacterCountOf(userBefore.data))
        && isValidCcfoliaCharacterCount(ccfoliaCharacterCountOf(userAfter.data))
        && ccfoliaCharacterCountOf(userAfter.data) == ccfoliaCharacterCountOf(userBefore.data) + 1
        && userAfter.data.ccfoliaCharacterCountSyncCharacterId is string
        && userAfter.data.ccfoliaCharacterCountSyncCharacterId == characterId;
    }

    function isCcfoliaCharacterCountDecrementSynced(uid, characterId) {
      let userBefore = linkedUser(uid);
      let userAfter = linkedUserAfter(uid);

      return userBefore.data != null
        && userAfter.data != null
        && isValidCcfoliaCharacterCount(ccfoliaCharacterCountOf(userBefore.data))
        && isValidCcfoliaCharacterCount(ccfoliaCharacterCountOf(userAfter.data))
        && ccfoliaCharacterCountOf(userAfter.data) == ccfoliaCharacterCountOf(userBefore.data) - 1
        && userAfter.data.ccfoliaCharacterCountSyncCharacterId is string
        && userAfter.data.ccfoliaCharacterCountSyncCharacterId == characterId;
    }

    function isCcfoliaCharacterCreateWithinLimit(uid) {
      let userBefore = linkedUser(uid);
      return userBefore.data != null
        && (
          userBefore.data.plan != 'free'
          || ccfoliaCharacterCountOf(userBefore.data) < 3
        );
    }

    function isFreePlanCreateWithinLimit(uid) {
      let userBefore = linkedUser(uid);
      return userBefore.data != null
        && (
          userBefore.data.plan != 'free'
          || analysisCountOf(userBefore.data) < 3
        );
    }

    match /users/{userId} {
      allow get: if isSelf(userId);
      allow list: if false;

      allow create: if isSelf(userId)
        && isValidUserDocument(request.resource.data)
        && request.resource.data.id == userId
        && request.resource.data.plan == 'free'
        && request.resource.data.analysisCount == 0
        && ccfoliaCharacterCountOf(request.resource.data) == 0
        && request.resource.data.stripeCustomerId == ''
        && (!('stripeSubscriptionId' in request.resource.data) || request.resource.data.stripeSubscriptionId == '')
        && request.resource.data.analysisCountSyncAnalysisId == null
        && (!('ccfoliaCharacterCountSyncCharacterId' in request.resource.data)
          || request.resource.data.ccfoliaCharacterCountSyncCharacterId == null);

      allow update: if isSelf(userId)
        && isValidUserDocument(request.resource.data)
        && (
          isUserProfileUpdateOnly()
          || isUserAnalysisCountSyncUpdate()
          || isUserCcfoliaCharacterCountSyncUpdate()
        );

      allow delete: if false;
    }

    match /users/{userId}/ccfoliaCharacters/{characterId} {
      allow get: if isSelf(userId);
      allow list: if isSelf(userId)
        && request.query.limit != null
        && request.query.limit <= 50;

      allow create: if isSelf(userId)
        && isValidCcfoliaCharacterDocument(request.resource.data, characterId)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isCcfoliaCharacterCreateWithinLimit(userId)
        && isCcfoliaCharacterCountIncrementSynced(userId, characterId);

      allow update: if isSelf(userId)
        && isValidCcfoliaCharacterDocument(request.resource.data, characterId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.revision == resource.data.revision + 1;

      allow delete: if isSelf(userId)
        && isCcfoliaCharacterCountDecrementSynced(userId, characterId);
    }

    match /analyses/{analysisId} {
      allow get: if canReadAnalysisDoc();
      allow list: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || resource.data.visibilityLevel == 'public';

      allow create: if isAnalysisOwnerByRequest()
        && isValidAnalysisDocument(request.resource.data, analysisId)
        && isFreePlanCreateWithinLimit(request.auth.uid)
        && isAnalysisCountIncrementSynced(request.auth.uid, analysisId);

      allow update: if isAnalysisOwnerByResource()
        && isValidAnalysisDocument(request.resource.data, analysisId)
        && (isAnalysisMetaUpdateOnly() || isAnalysisOwnerSyncUpdateOnly());

      allow delete: if isAnalysisOwnerByResource()
        && isAnalysisCountDecrementSynced(request.auth.uid, analysisId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
