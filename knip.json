{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/blogs/[category]/[slug]/_contents/*/*.mdx",
    "firebase/**/*.test.ts",
    "src/**/*.test.ts",
    "src/**/*.bench.ts",
    "src/test/**/*.ts"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx,mdx}"],
  "ignoreDependencies": ["tailwindcss-animate", "tailwindcss", "cssnano", "postcss-syntax", "next", "micromatch"],
  "next": true
}
