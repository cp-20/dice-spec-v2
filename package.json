  "author": "cp20",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "bench": "node --import tsx src/features/dice-expectation/expecter/index.bench.ts && node --import tsx src/features/dice-expectation/expecter/parser.bench.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "test": "vitest run --exclude 'firebase/*.rules.test.ts'",
    "test:firebase": "vitest run firebase/*.rules.test.ts",
    "test:e2e": "playwright test",
    "firebase:deploy:prod": "firebase deploy --config firebase/firebase.json",
    "firebase:deploy:dev": "firebase deploy --config firebase/firebase-dev.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "stylelint": "stylelint --ignore-path .gitignore --ignore-path .stylelintignore './src/**/*.{css,scss}'",
    "typecheck": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
